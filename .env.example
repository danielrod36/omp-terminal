# omp-terminal configuration — copy to .env and edit, or export these directly.

# Stable pairing token. Leave unset and the bridge generates one on first run
# and persists it to ~/.omp-terminal/config.json, so the glasses never re-pair
# across restarts. Set it to override that saved value.
# BRIDGE_TOKEN=changeme

# Network
# PORT=3456
# BIND_HOST=0.0.0.0

# Workspace for new sessions
# PROJECT_DIR=/home/you/project

# omp integration
# OMP_TERMINAL_OMP_COMMAND=omp
# OMP_TERMINAL_APPROVAL_MODE=always-ask
# OMP_TERMINAL_SESSIONS_ROOT=/home/you/.omp/agent/sessions
# OMP_TERMINAL_ATTACH=true
# OMP_TERMINAL_BUSY_WINDOW_MS=120000

# Cross-origin browser requests (off by default; native app is unaffected)
# EVEN_ALLOW_CORS=0

# Log level: debug | info
# OMP_TERMINAL_LOG_LEVEL=info

# Public tunnel program overrides (only needed when the binary is not on PATH)
# CLOUDFLARED_PROGRAM_PATH=/usr/bin/cloudflared
# PINGGY_PROGRAM_PATH=ssh
# BORE_PROGRAM_PATH=bore
# NGROK_PROGRAM_PATH=ngrok
