{
	"name": "@daniel/omp-terminal",
	"version": "0.1.0",
	"description": "Even Realities G2 Terminal Mode bridge for oh-my-pi (omp) — HTTP/SSE wire-compatible with @evenrealities/even-terminal",
	"type": "module",
	"bin": {
		"omp-terminal": "bin/omp-terminal.js"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"check": "node scripts/check-syntax.mjs",
		"test": "node test/smoke.mjs --no-omp && node test/attach.mjs",
		"test:ci": "node test/smoke.mjs --no-omp",
		"test:smoke": "node test/smoke.mjs",
		"test:attach": "node test/attach.mjs",
		"test:live": "node test/smoke.mjs && node test/attach.mjs --live"
	},
	"license": "MIT",
	"private": true
}
